{
  "modules": [
    "./register.tsx"
  ],
  "description": "Guards the factory's intake agent: it writes only its job's intake.md, reads only inside the repo and no secret-looking path, and uses no other tool; and says when the session runs an older kc-factory than is installed, so Claude asks for /reload-plugins",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-intake.sh\"",
            "shell": "bash",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-loaded-version.sh\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
